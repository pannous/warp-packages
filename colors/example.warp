#!/usr/bin/env warp
# warp example.warp: the colors package at work, an assert stops at the first wrong value
use colors

orange = from_hex("#ff8800")
assert to_hex(orange) == "#ff8800"
assert to_hex(from_hex("f80")) == "#ff8800"
assert to_hex(hsl(120, 1, 0.5)) == "#00ff00"
assert round(to_hsl(orange)#1) == 32
assert to_hex(mix(black, white, 0.5)) == "#808080"
assert to_hex(complement(from_hex("#ff0000"))) == "#00ffff"
assert count(rainbow(6)) == 6
assert contrast(black, white) ≈ 21
assert text_color_on(from_hex("#202040")) == white
print [to_hex(c) for c in triad(orange)]
